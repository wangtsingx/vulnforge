{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnForge Finding",
  "type": "object",
  "required": ["finding_id", "project_id", "status", "title", "evidence"],
  "properties": {
    "finding_id": {"type": "string"},
    "project_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["hypothesis", "candidate", "unconfirmed", "confirmed", "rejected"]
    },
    "title": {"type": "string"},
    "cwe": {"type": ["string", "null"]},
    "severity": {
      "type": "string",
      "enum": ["unknown", "info", "low", "medium", "high", "critical"]
    },
    "location": {
      "type": "object",
      "properties": {
        "revision": {"type": "string"},
        "file": {"type": "string"},
        "function": {"type": ["string", "null"]},
        "line_start": {"type": "integer"},
        "line_end": {"type": "integer"}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "verification": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "reproducible": {"type": "boolean"},
        "security_impact": {"type": ["string", "null"]}
      }
    }
  }
}
